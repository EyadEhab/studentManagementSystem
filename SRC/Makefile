stmmmmm.pro:
qmake: FORCE
	@$(QMAKE) -o Makefile stmmmmm.pro

qmake_all: FORCE


all: Makefile stmmmmm

dist: distdir FORCE
	(cd `dirname $(DISTDIR)` && $(TAR) $(DISTNAME).tar $(DISTNAME) && $(COMPRESS) $(DISTNAME).tar) && $(MOVE) `dirname $(DISTDIR)`/$(DISTNAME).tar.gz . && $(DEL_FILE) -r $(DISTDIR)

distdir: FORCE
	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents /usr/lib/x86_64-linux-gnu/qt5/mkspecs/features/data/dummy.cpp $(DISTDIR)/
	$(COPY_FILE) --parents adduser.h adminstrator.h course.h MainWindow.h signup2.h user.h instructor.h student.h start.h $(DISTDIR)/
	$(COPY_FILE) --parents adduser.cpp adminstrator.cpp main.cpp MainWindow.cpp signup2.cpp user.cpp instructor.cpp student.cpp start.cpp $(DISTDIR)/
	$(COPY_FILE) --parents adduser.ui adminstrator.ui mainwindow.ui signup2.ui instructor.ui student.ui start.ui $(DISTDIR)/


clean: compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) .qmake.stash
	-$(DEL_FILE) Makefile


