####### Compile

adduser.o: adduser.cpp adduser.h \
		ui_adduser.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o adduser.o adduser.cpp

adminstrator.o: adminstrator.cpp adminstrator.h \
		user.h \
		course.h \
		ui_adminstrator.h \
		adduser.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o adminstrator.o adminstrator.cpp

main.o: main.cpp start.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o main.cpp

MainWindow.o: MainWindow.cpp MainWindow.h \
		signup2.h \
		user.h \
		adminstrator.h \
		course.h \
		student.h \
		instructor.h \
		ui_mainwindow.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o MainWindow.o MainWindow.cpp

signup2.o: signup2.cpp signup2.h \
		ui_signup2.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o signup2.o signup2.cpp

user.o: user.cpp user.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o user.o user.cpp

instructor.o: instructor.cpp instructor.h \
		user.h \
		ui_instructor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o instructor.o instructor.cpp

student.o: student.cpp student.h \
		user.h \
		ui_student.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o student.o student.cpp

start.o: start.cpp start.h \
		ui_start.h \
		MainWindow.h \
		signup2.h \
		user.h \
		adminstrator.h \
		course.h \
		student.h \
		instructor.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o start.o start.cpp

moc_adduser.o: moc_adduser.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_adduser.o moc_adduser.cpp

moc_adminstrator.o: moc_adminstrator.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_adminstrator.o moc_adminstrator.cpp

moc_MainWindow.o: moc_MainWindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_MainWindow.o moc_MainWindow.cpp

moc_signup2.o: moc_signup2.cpp 
